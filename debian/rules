#!/usr/bin/make -f

# Build daemons can have a nonexistent HOME, breaking the default GOCACHE.
export GOCACHE := $(CURDIR)/.go-cache

# We vendor our dependencies.
export GOFLAGS := -mod=vendor

# Install everything from the source tree, not just the *.go files.
export DH_GOLANG_INSTALL_ALL := 1

DEB_VERSION := $(shell dpkg-parsechangelog -SVersion)

# Keep in sync with debian/dirs and debian/service.
CONFFILE := /etc/GeoIP.conf
DATADIR := /usr/share/GeoIP

GO_LDFLAGS := -X main.defaultConfigFile=$(CONFFILE) \
              -X main.defaultDatabaseDirectory=$(DATADIR) \
              -X 'main.version=$(DEB_VERSION) (ubuntu-ppa)'

GO_FLAGS := -buildmode=pie -ldflags "$(GO_LDFLAGS)"

%:
	dh $@ --buildsystem=golang --with=golang

override_dh_auto_build:
	make CONFFILE=$(CONFFILE) DATADIR=$(DATADIR) data
	dh_auto_build -- $(GO_FLAGS)

override_dh_auto_install:
	dh_auto_install -- --no-source

override_dh_installchangelogs:
	dh_installchangelogs CHANGELOG.md

override_dh_installsystemd:
	@# Only the timer is enabled; starting the oneshot would block dpkg.
	dh_installsystemd --no-enable --no-start geoipupdate.service
	dh_installsystemd geoipupdate.timer
